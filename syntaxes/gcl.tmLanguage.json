{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "GCL",
  "scopeName": "source.gcl",
  "patterns": [
    { "include": "#comment" },
    { "include": "#resource-line" },
    { "include": "#header" },
    { "include": "#annotation" },
    { "include": "#string" },
    { "include": "#keyword" },
    { "include": "#command-head" },
    { "include": "#call" },
    { "include": "#procref" },
    { "include": "#variable" },
    { "include": "#option" },
    { "include": "#hash" },
    { "include": "#number" },
    { "include": "#operator" },
    { "include": "#continuation" }
  ],
  "repository": {
    "comment": { "match": "#.*$", "name": "comment.line.number-sign.gcl" },
    "resource-line": {
      "match": "^(\\d+)\\s+([sv])(?=\\s)",
      "captures": { "1": { "name": "constant.numeric.resource-index.gcl" }, "2": { "name": "storage.type.resource-kind.gcl" } }
    },
    "header": {
      "patterns": [
        {
          "match": "^\\s*(proc)((?:\\s+\\d+(?::\\d+)?)+)",
          "captures": { "1": { "name": "keyword.declaration.proc.gcl" }, "2": { "name": "entity.name.function.proc.gcl" } }
        },
        { "match": "^\\s*(main)\\b", "captures": { "1": { "name": "keyword.declaration.main.gcl" } } },
        {
          "match": "^\\s*(gcx|pad)\\b(.*)$",
          "captures": { "1": { "name": "keyword.other.directive.gcl" }, "2": { "name": "comment.block.documentation.gcl" } }
        }
      ]
    },
    "annotation": { "match": "%\\([^)]*\\)", "name": "comment.block.documentation.annotation.gcl" },
    "string": {
      "patterns": [
        {
          "begin": "([eb]?)\"", "end": "\"",
          "beginCaptures": { "1": { "name": "storage.modifier.string-encoding.gcl" } },
          "name": "string.quoted.double.gcl",
          "patterns": [{ "match": "\\\\(x[0-9a-fA-F]{2}|.)", "name": "constant.character.escape.gcl" }]
        }
      ]
    },
    "keyword": { "match": "(?<![\\w$@-])(if|else|switch|case|default)(?![\\w])", "name": "keyword.control.gcl" },
    "command-head": {
      "match": "^\\s*(?:%\\([^)]*\\))?(?!(?:if|else|switch|case|default|proc|main|gcx|pad)\\b)([A-Za-z_][A-Za-z0-9_]*|\\[[0-9a-fA-F]+(?:/[^\\]]*)?\\])(?=\\s|$)",
      "captures": { "1": { "name": "entity.name.function.command.gcl" } }
    },
    "call": { "match": "@proc\\d+", "name": "support.function.call.gcl" },
    "procref": { "match": "\\bp:proc\\d+\\b", "name": "support.function.procref.gcl" },
    "variable": {
      "patterns": [
        { "match": "\\$res:\\d+", "name": "variable.other.constant.resource.gcl" },
        { "match": "\\$(status|arg\\d+(?::raw[0-9a-f]+)?|local\\d+)\\b", "name": "variable.parameter.argument.gcl" },
        { "match": "\\$(?:arr\\.|tag\\d+\\.)?\\w+@\\w+:[0-9a-fA-F]+(?:\\.b\\d+)?", "name": "variable.other.global.gcl" }
      ]
    },
    "option": {
      "match": "(?<=\\s|^)-(?:[A-Za-z][A-Za-z0-9_]*(?:\\[[0-9a-fA-F]+\\])?|\\\\x[0-9a-f]{2}\\[[0-9a-fA-F]+\\])",
      "name": "variable.parameter.option.gcl"
    },
    "hash": {
      "match": "(\\[)([0-9a-fA-F]+)(?:(/)([^\\]]*))?(\\])",
      "captures": {
        "1": { "name": "punctuation.definition.hash.gcl" }, "2": { "name": "constant.numeric.hex.hash.gcl" },
        "3": { "name": "punctuation.separator.gcl" }, "4": { "name": "entity.name.type.label.gcl" },
        "5": { "name": "punctuation.definition.hash.gcl" }
      }
    },
    "number": {
      "patterns": [
        { "match": "\\bvec:-?\\d+,-?\\d+,-?\\d+", "name": "constant.numeric.vector.gcl" },
        { "match": "(?<![\\w$@])(-?\\d+|0x[0-9a-fA-F]+)(:(?:s16|u8|char|bool|u16|s32|sym|u32|u8b|u8c|small))?\\b",
          "captures": { "1": { "name": "constant.numeric.gcl" }, "2": { "name": "storage.type.number-type.gcl" } } }
      ]
    },
    "operator": { "match": "==|!=|<=|>=|<<|>>|&&|\\|\\||(?<=\\s)[-+*/%&|^~!<>=](?=\\s)", "name": "keyword.operator.gcl" },
    "continuation": { "match": "\\\\$", "name": "punctuation.separator.continuation.gcl" }
  }
}
